  "production_quality_floor": {
    "characters": {
      "target": "MetaHuman / City Sample crowd quality or equivalent",
      "first_person": "dedicated skeletal arms/hands plus separate first-person weapon mount",
      "skin": "subsurface skin shading, detailed normals, roughness variation, eyes/teeth/hair/grooms",
      "infected": "high-fidelity human rigs with Horizon-authored damage/decay/wound materials and meshes",
      "forbidden_shipping_defaults": [
        "Quaternius survivor",
        "MakeHuman prototype",
        "primitive capsule/cube human"
      ]
    },
