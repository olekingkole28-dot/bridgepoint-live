        "City Sample Buildings",
        "Electric Dreams Env",
        "Poly Haven CC0",
        "ambientCG CC0"
      ],
      "materials": "photoreal PBR with base color, normal, roughness, metallic/AO where applicable",
      "rendering": [
        "Nanite",
        "Lumen GI",
        "Lumen reflections",
        "Virtual Shadow Maps",
        "TSR",
        "volumetric fog",
        "high-quality post"
      ]
    },
    "effects": {
      "target": "Niagara-quality fire/smoke/muzzle/impact/blood/weather effects",
      "no_final_primitives": true
    },
    "fallback_policy": {
      "browser_pwa": "lightweight assets allowed for reach/performance",
      "native_unreal": "low-poly packs fallback-only, never primary production look",
      "autopilot": "scale quality dynamically rather than globally lowering native baseline"
    }
  },
